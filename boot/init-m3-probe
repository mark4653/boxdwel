#!/bin/busybox sh
# M3 transport-probe 게스트 PID 1 — 측정 전용. COM1은 진단만, 셸/PTY 없음.
# 필수 초기화가 실패하면 READY 신호를 내지 않는다. M2 boot/init은 건드리지 않는다.
BB=/bin/busybox
PATH=/bin

fail() {
	echo "M3_INIT_ERROR: $*" >/dev/console
	exit 1
}

[ -x "$BB" ] || exit 1
exec >/dev/console 2>&1 || exit 1

"$BB" mount -t devtmpfs devtmpfs /dev || fail "mount devtmpfs"
"$BB" mount -t proc proc /proc || fail "mount proc"
"$BB" mount -t sysfs sysfs /sys || fail "mount sysfs"

[ -c /dev/console ] || fail "/dev/console missing"
[ -r /proc/1/cmdline ] || fail "/proc not mounted"
[ -d /sys/kernel ] || fail "/sys not mounted"

echo "READY_BOOT_M1"

[ -c /dev/ttyS1 ] || fail "/dev/ttyS1 missing"
"$BB" stty -F /dev/ttyS1 raw 115200 -echo || fail "configure /dev/ttyS1"
[ -x /bin/m3-transport-probe ] || fail "/bin/m3-transport-probe missing"

# 두 phase는 각각 새 프로세스다. phase1이 clean boundary로 끝나면 phase2가
# 새 Hello를 기다린다. 실패하면 추가 probe 없이 진단만 남기고 멈춘다.
run_phase() {
	phase=$1
	echo "M3_PHASE${phase}_START"
	/bin/m3-transport-probe -dev /dev/ttyS1 -deadline 120s
	rc=$?
	if [ "$rc" -ne 0 ]; then
		echo "M3_PHASE${phase}_FAIL rc=$rc"
		fail "phase $phase failed rc=$rc"
	fi
	echo "M3_PHASE${phase}_EXIT rc=0"
}

run_phase 1
run_phase 2
echo "M3_PROBE_DONE"

# PID 1은 살아 있어야 한다. 측정이 끝난 뒤 추가 probe나 셸을 시작하지 않는다.
while :; do
	"$BB" sleep 3600
done
